# Optional LLM for candidate notes and --ask mode. Scores never depend on it.
LLM_PROVIDER=ollama            # none | ollama | openai | openrouter
OLLAMA_MODEL=llama3.1:8b       # any tool-capable model you have pulled
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...

# Filesystem MCP server overrides (see `python filesystem_mcp_server.py --print-config`)
# MCP_FS_ROOT=.
# MCP_FS_BATCH_MAX_WORKERS=8
# MCP_FS_WATCH_POLL_INTERVAL=0.5
